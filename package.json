{
  "name": "tauri-plugin",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "WHF 股票看板的官方插件源码与分发产物（宿主应用仓库：whf-stock-board）",
  "scripts": {
    "build": "node scripts/build-plugins.mjs",
    "build:mainline": "node scripts/build-plugins.mjs dsh-mainline",
    "build:dividend": "node scripts/build-plugins.mjs dsh-dividend-screen",
    "build:note": "node scripts/build-plugins.mjs dsh-quick-note",
    "build:watch": "node scripts/build-plugins.mjs dsh-sidebar-watch",
    "sync:host": "node scripts/sync-host-contract.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint plugins scripts",
    "lint:fix": "eslint plugins scripts --fix",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/api": "^2.11.1",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.10.0",
    "eslint-plugin-jsdoc": "^64.3.9",
    "eslint-plugin-vue": "^10.11.0",
    "fflate": "^0.8.3",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "stock-sdk": "^2.4.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vue": "^3.5.42",
    "vue-draggable-plus": "^0.6.1",
    "vue-tsc": "^3.3.11",
    "zod": "^4.6.4"
  },
  "engines": {
    "node": ">=22"
  }
}
